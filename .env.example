# Base URL of the Pathik Multi-Agent Pipeline API (the /api/planning/ surface).
# All 28 endpoints in src/shared/api/endpoints.ts are relative to this.
#
# Local dev against the Django backend in ../SE_automation_server: use a relative
# path and let the Vite dev proxy (vite.config.ts) forward it to localhost:8000 -
# avoids needing CORS headers on the Django side.
VITE_API_BASE_URL=/api/planning

# Pointed directly at a deployed backend instead (no proxy):
# VITE_API_BASE_URL=https://your-deployed-host/api/planning
